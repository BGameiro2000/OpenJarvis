# Single source of truth for what the Unraid images are built from.
# Bump OPENJARVIS_COMMIT (and OPENJARVIS_VERSION) in one commit after
# "Sync fork", rebuild, and run the tests in docs/VERIFY.md before deploying.
OPENJARVIS_COMMIT=cf464de1ff13d84dede80eb07e5e45c1d06708ba
OPENJARVIS_VERSION=0.0.1.dev88
# Bump when anything under deploy/unraid/ changes the OpenJarvis image.
UNRAID_LAYER_VERSION=1
# Official cognee/cognee image tag the Cognee layer is built on.
COGNEE_VERSION=1.6.5
# Bump when deploy/unraid/cognee/ changes.
COGNEE_LAYER_VERSION=1
# Machine HUD (deploy/unraid/hud/). Bump HUD_VERSION when hud/ changes.
HUD_VERSION=0.1.0
HUD_NODE_IMAGE=node:22.22.0-bookworm-slim
HUD_PYTHON_IMAGE=python:3.12.12-slim-bookworm
